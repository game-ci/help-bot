{
  "name": "gameci-help-bot",
  "version": "3.0.0",
  "description": "TypeScript-styled orchestrator for the GameCI Help Bot",
  "main": "dist/cli.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "cycle": "npm run build && node dist/cli.js cycle",
    "continuous": "npm run build && node dist/cli.js continuous",
    "dev": "node scripts/ensure-husky.mjs && ts-node src/cli.ts",
    "vector-bake": "npm run build && node dist/cli.js vector-bake",
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "yarn oxlint --report-unused-disable-directives",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts|js|jsx|mjs|cjs)": [
      "oxlint --fix --quiet",
      "oxfmt --write"
    ],
    "*.@(json|jsonc|json5|md|mdx|yaml|yml|css|scss|sass|html|toml)": "oxfmt --write",
    ".github/workflows/*.@(yml|yaml)": "actionlint"
  },
  "bin": "dist/cli.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "discord.js": "^14.25.1",
    "dotenv": "^16.5.0",
    "glob": "^13.0.6",
    "keytar": "^7.9.0",
    "node-html-parser": "^7.0.1",
    "prompts": "^2.4.2",
    "turndown": "^7.1.1",
    "undici": "^5.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "@types/yargs": "^17.0.24",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "9",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.6",
    "vitest": "^4"
  },
  "packageManager": "yarn@4.14.1",
  "dependenciesMeta": {
    "keytar": {
      "built": true
    }
  }
}
