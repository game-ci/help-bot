# Synced data (ephemeral, re-synced each cycle)
# Keep directory structure via .gitkeep files
data/discord/channels/
data/github/issues/*
!data/github/issues/.gitkeep
data/github/discussions/*
!data/github/discussions/.gitkeep
data/docs/*.md
data/responses/discord/*.md
data/responses/github/*.md

# Node
node_modules/

# Environment and secrets
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
